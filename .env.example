# Copy this file to .env and fill in your key for local development.
# .env is gitignored — never commit your actual key.
#
# Production / deployed Lambda: create an SSM SecureString parameter instead:
#   aws ssm put-parameter --name /nube/google-maps-key --type SecureString --value <key>
# Then grant the execution role ssm:GetParameter on that path.
GOOGLE_MAPS_API_KEY=
